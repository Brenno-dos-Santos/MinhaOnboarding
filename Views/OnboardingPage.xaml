<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MinhaOnboardingPage.Views.OnboardingPage"
             xmlns:viewmodels="clr-namespace:MinhaOnboardingPage.ViewModel"  
             xmlns:models="clr-namespace:MinhaOnboardingPage.Models"
             x:DataType="viewmodels:OnboudingViewModel"
             BackgroundColor="#D0D0D0"
             Shell.NavBarIsVisible="False"
             Title="OnboardingPage">

    <Grid RowDefinitions="*, Auto,Auto" Padding="5,10">
        <CarouselView Grid.Row="0" Position="{Binding Posicao}" IndicatorView="Indicador" Loop="True" ItemsSource="{Binding Itens}">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="models:OnboardingItem">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="20">
                        <Label Text="{Binding Titulo}" FontSize="28" TextColor="#333" FontAttributes="Bold"/>
                        <Image Source="{Binding ImagemUrl}" Aspect="AspectFit" HeightRequest="250"/>
                        <Label Text="{Binding Descricao}" FontSize="18" TextColor="#333" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>
        <IndicatorView x:Name="Indicador" Grid.Row="1"  HorizontalOptions="Center" IndicatorColor="#fff" SelectedIndicatorColor="#80C46B" IndicatorSize="14"/>
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="15">
            <Button Grid.Column="0" Text="Começar" BackgroundColor="#80C468"/>
            <Button Grid.Column="1" Command="{Binding ProximoCommand}" Text="Avançar" BackgroundColor="#F0A46B" IsVisible="{Binding ExibirBotao}"/>
        </Grid>
    </Grid>
</ContentPage>